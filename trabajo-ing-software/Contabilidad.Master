<%@ Master Language="C#" %>
<script runat="server">
    private static readonly string[][] VistasCompras = {
        new[] { "Compras", "Resumen de Compras", "M18 20V10 M12 20V4 M6 20v-6", "Compras.aspx" },
        new[] { "Marcas", "Marcas", "M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z M7 7h.01", "Marcas.aspx" },
        new[] { "Laboratorios", "Laboratorios y proveedores", "M4 21h16 M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16 M10 9h4 M10 13h4 M10 21v-4h4v4", "Laboratorios.aspx" },
        new[] { "CotizacionesImportacion", "Cotizaciones de importación", "M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z M2 12h20 M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z", "CotizacionesImportacion.aspx" },
        new[] { "OrdenesCompra", "Órdenes de compra", "M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2 M9 3h6v4H9z M9 12h6 M9 16h4", "OrdenesCompra.aspx" },
        new[] { "Recepciones", "Recepciones y lotes", "M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96L12 12.01l8.73-5.05 M12 22.08V12", "Recepciones.aspx" },
        new[] { "DevolucionesProveedor", "Devoluciones y reclamos", "M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11", "DevolucionesProveedor.aspx" }
    };

    private static readonly string[] ReportesCompras = {
        "ReporteProveedores",
        "ReporteOrdenesCompra",
        "ReporteIngresos",
        "ReporteCotizaciones",
        "ReporteComprasLaboratorio"
    };

    private static readonly string[][] VistasVentas = {
        new[] { "VentasResumen", "Resumen de Ventas", "M18 20V10 M12 20V4 M6 20v-6", "Ventas.aspx?vista=resumen" },
        new[] { "VentasPOS", "Punto de venta", "M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z M3 6h18 M16 10a4 4 0 0 1-8 0", "Ventas.aspx?vista=pos" },
        new[] { "Clientes", "Clientes", "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0 M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75", "Clientes.aspx" },
        new[] { "Cotizaciones", "Cotizaciones", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8", "Cotizaciones.aspx" },
        new[] { "Despachos", "Despachos", "M1 3h15v13H1z M16 8h4l3 3v5h-7V8z M5.5 18.5m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M18.5 18.5m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0", "Despachos.aspx" },
        new[] { "Devoluciones", "Devoluciones", "M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11", "Devoluciones.aspx" }
    };

    private static readonly string[] ReportesVentas = {
        "ReporteVentas"
    };

    private static readonly string[][] VistasAdmin = {
        new[] { "Usuarios", "Gestión de usuarios", "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0", "Usuarios.aspx" },
        new[] { "Auditoria", "Auditoría", "M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2 M9 3h6v4H9z M9 14l2 2 4-4", "Auditoria.aspx" },
        new[] { "Accesos", "Asignación de accesos", "M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4", "Accesos.aspx" },
        new[] { "Perfiles", "Perfiles y roles", "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z", "Perfiles.aspx" },
        new[] { "Privacidad", "Privacidad y datos", "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4", "Privacidad.aspx" }
    };

    protected bool EsInventario => PaginaActual == "Inventario" || PaginaActual == "Gestion" || PaginaActual == "ReporteInventario";
    protected bool EsInicio => PaginaActual == "Default";
    protected bool EsVentas => PaginaActual == "Ventas"
        || Array.Exists(VistasVentas, vista => vista[0] == PaginaActual)
        || Array.Exists(ReportesVentas, r => r == PaginaActual);
    protected bool EsAdminVista => Array.Exists(VistasAdmin, vista => vista[0] == PaginaActual);
    protected string RolActual => (Convert.ToString(Session["RolUsuario"]) ?? "").Trim();
    protected bool EsRolAdmin => string.Equals(RolActual, "Administrador", StringComparison.OrdinalIgnoreCase)
        || string.Equals(RolActual, "Administrador General", StringComparison.OrdinalIgnoreCase);
    protected bool PuedeGestionarInventario => EsRolAdmin || string.Equals(RolActual, "Bodeguero", StringComparison.OrdinalIgnoreCase);
    protected string NombreModulo => EsCompras ? "Compras" : EsVentas ? "Ventas" : EsInventario ? "Inventario" : EsAdminVista ? (EsRolAdmin ? "Usuarios" : "Privacidad") : EsInicio ? "Inicio" : "Contabilidad";

    protected string InicialUsuario
    {
        get
        {
            string nombre = Convert.ToString(Session["NombreUsuario"]);
            return string.IsNullOrWhiteSpace(nombre) ? "D" : nombre.Trim().Substring(0, 1).ToUpperInvariant();
        }
    }

    protected string PaginaActual
    {
        get { return System.IO.Path.GetFileNameWithoutExtension(Page.AppRelativeVirtualPath); }
    }

    protected string ClaveSeccionActual
    {
        get
        {
            if (PaginaActual == "Ventas")
            {
                bool esPos = string.Equals(Request.QueryString["vista"], "pos", StringComparison.OrdinalIgnoreCase)
                    || !string.IsNullOrEmpty(Request.QueryString["idCotizacion"]);
                return esPos ? "VentasPOS" : "VentasResumen";
            }
            if (PaginaActual == "ReporteVentas")
            {
                string origen = (Request.QueryString["origen"] ?? "").ToLowerInvariant();
                switch (origen)
                {
                    case "pos": return "VentasPOS";
                    case "clientes": return "Clientes";
                    case "cotizaciones": return "Cotizaciones";
                    case "despachos": return "Despachos";
                    case "devoluciones": return "Devoluciones";
                    case "resumen": return "VentasResumen";
                    default: return PaginaActual;
                }
            }
            if (PaginaActual == "Inventario")
            {
                bool esExistencias = string.Equals(Request.QueryString["vista"], "existencias", StringComparison.OrdinalIgnoreCase);
                return esExistencias ? "InventarioExistencias" : "InventarioResumen";
            }
            if (PaginaActual == "Gestion")
            {
                return "Gestion_" + (Request.QueryString["m"] ?? "productos").ToLowerInvariant();
            }
            return PaginaActual;
        }
    }

    protected bool EsCompras
    {
        get
        {
            return Array.Exists(VistasCompras, vista => vista[0] == PaginaActual)
                || Array.Exists(ReportesCompras, r => r == PaginaActual);
        }
    }

    protected override void OnPreRender(EventArgs e)
    {
        base.OnPreRender(e);
        if (Session["IdUsuario"] != null && int.TryParse(Convert.ToString(Session["IdUsuario"]), out int idUsr) && idUsr > 0)
        {
            try
            {
                var entry = System.Configuration.ConfigurationManager.ConnectionStrings["DefaultConnection"];
                if (entry != null)
                {
                    using (var con = new MySql.Data.MySqlClient.MySqlConnection(entry.ConnectionString))
                    using (var cmd = new MySql.Data.MySqlClient.MySqlCommand("SELECT Nombre, Rol FROM usuario WHERE IdUsuario=@id LIMIT 1", con))
                    {
                        cmd.Parameters.AddWithValue("@id", idUsr);
                        con.Open();
                        using (var r = cmd.ExecuteReader())
                        {
                            if (r.Read())
                            {
                                Session["NombreUsuario"] = Convert.ToString(r["Nombre"]);
                                Session["RolUsuario"] = Convert.ToString(r["Rol"]);
                            }
                        }
                    }
                }
            }
            catch { }
        }
    }
</script>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Dermo ERP</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" runat="server" />
    <link href="<%: ResolveUrl("~/Content/Estilos.css?v=2") %>" rel="stylesheet" />
    <link href="<%: ResolveUrl("~/Content/ComprasResumen.css?v=4") %>" rel="stylesheet" />
    <link href="<%: ResolveUrl("~/Content/Contabilidad.css?v=19") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="EstilosPagina" runat="server" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server" EnablePartialRendering="false" />
        <header class="erp-header">
            <div class="erp-logo">
                <span class="logo-simbolo" aria-hidden="true">D</span>
                <div>
                    <span class="logo-titulo">Dermo ERP</span>
                    <span class="logo-subtitulo">Sistema ERP</span>
                </div>
            </div>
            <span class="erp-contexto"><%: NombreModulo %> / <%: Page.Title %></span>
            <div class="erp-usuario">
                <div class="usuario-info">
                    <span class="usuario-nombre"><%: Convert.ToString(Session["NombreUsuario"]) %></span>
                    <span class="usuario-rol"><%: Convert.ToString(Session["RolUsuario"]) %></span>
                </div>
                <span class="usuario-avatar" aria-hidden="true"><%: InicialUsuario %></span>
                <asp:ContentPlaceHolder ID="AccionesUsuario" runat="server" />
            </div>
        </header>
        <div class="erp-layout">
            <aside class="erp-sidebar">
                <nav class="erp-menu" aria-label="Secciones de <%: NombreModulo %>">
                    <span class="menu-titulo">Módulos principales</span>
                    <%
                        var modulosLista = new System.Collections.Generic.List<string[]> {
                            new[] { "Inicio", "Default.aspx", "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" },
                            new[] { "Compras", "Compras.aspx", "M5 7h14v14H5z M9 8V6a3 3 0 0 1 6 0v2" },
                            new[] { "Ventas", "Ventas.aspx?vista=resumen", "M5 9h14l2 4v7H3v-7z M7 9V4h10v5 M7 15h3 M15 15h2" },
                            new[] { "Inventario", "Inventario.aspx?vista=resumen", "M3 4h18v5H3z M5 9v11h14V9 M10 13h4" },
                            new[] { "Contabilidad", "Contabilidad.aspx?vista=diario", "M3 9l9-6 9 6H3z M5 20h14 M7 10v7 M12 10v7 M17 10v7" }
                        };
                        if (EsRolAdmin)
                        {
                            modulosLista.Add(new[] { "Usuarios", "Usuarios.aspx", "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0" });
                        }
                        foreach (var modulo in modulosLista)
                        {
                            string rol = RolActual;
                            bool esComprador = string.Equals(rol, "Comprador", StringComparison.OrdinalIgnoreCase);
                            bool esContador = string.Equals(rol, "Contador", StringComparison.OrdinalIgnoreCase);
                            bool esBodeguero = string.Equals(rol, "Bodeguero", StringComparison.OrdinalIgnoreCase);
                            if (!EsRolAdmin && ((modulo[0] == "Compras" && !esComprador && !esContador) ||
                                (modulo[0] == "Contabilidad" && !esContador) || (modulo[0] == "Ventas" && esComprador))) continue;
                            if (modulo[0] == "Ventas" && esBodeguero) modulo[1] = "Despachos.aspx";
                            bool activo = NombreModulo == modulo[0];
                    %>
                    <a class="menu-item<%: activo ? " principal-activo" : "" %>"
                       aria-current="<%: activo ? "location" : "false" %>"
                       href="<%: ResolveUrl("~/" + modulo[1]) %>">
                        <span class="menu-icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="<%: modulo[2] %>" /></svg></span>
                        <%: modulo[0] %>
                    </a>
                    <% } %>
                    <% if (Session["IdUsuario"] == null) { %>
                    <a class="menu-item" href="<%: ResolveUrl("~/Login.aspx") %>">Iniciar sesión</a>
                    <% } %>
                    <% if (!EsInicio) { %>
                    <div class="menu-separador"></div>
                    <span class="menu-titulo"><%: NombreModulo %></span>
                    <% } %>
                    <% if (EsInventario) {
                        foreach (var entrada in new[] {
                            new[] { "InventarioResumen", "Inventario.aspx?vista=resumen", "Resumen de Inventario", "M18 20V10 M12 20V4 M6 20v-6", "consulta" },
                            new[] { "InventarioExistencias", "Inventario.aspx?vista=existencias", "Existencias", "M3 4h18v5H3z M5 9v11h14V9 M10 13h4", "consulta" },
                            new[] { "Gestion_productos", "Gestion.aspx?m=productos", "Productos", "M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z M7 7h.01", "gestion" },
                            new[] { "Gestion_variantes", "Gestion.aspx?m=variantes", "Variantes", "M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5", "gestion" },
                            new[] { "Gestion_lotes", "Gestion.aspx?m=lotes", "Lotes", "M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96L12 12.01l8.73-5.05 M12 22.08V12", "gestion" },
                            new[] { "Gestion_movimientos", "Gestion.aspx?m=movimientos", "Movimientos", "M7 16V4m0 0L3 8m4-4l4 4 M17 8v12m0 0l4-4m-4 4l-4-4", "gestion" },
                            new[] { "Gestion_historial", "Gestion.aspx?m=historial", "Historial", "M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z M12 6v6l4 2", "consulta" },
                            new[] { "Gestion_alertas", "Gestion.aspx?m=alertas", "Alertas", "M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01", "consulta" },
                            new[] { "ReporteInventario", "ReporteInventario.aspx", "Reporte de inventario", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8", "consulta" }
                        }) {
                            if (entrada[4] == "gestion" && !PuedeGestionarInventario) continue; %>
                    <a class="menu-item" aria-current="<%: ClaveSeccionActual == entrada[0] ? "page" : "false" %>" href="<%: ResolveUrl("~/" + entrada[1]) %>">
                        <span class="menu-icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="<%: entrada[3] %>" /></svg></span>
                        <%: entrada[2] %>
                    </a>
                    <% } } else if (EsCompras || EsVentas || EsAdminVista) {
                        foreach (var seccion in (EsCompras ? VistasCompras : EsVentas ? VistasVentas : VistasAdmin))
                        {
                            if (EsVentas && string.Equals(RolActual, "Bodeguero", StringComparison.OrdinalIgnoreCase) && seccion[0] != "Despachos") continue;
                            if (EsVentas && string.Equals(RolActual, "Contador", StringComparison.OrdinalIgnoreCase) && seccion[0] == "VentasPOS") continue;
                            if (EsAdminVista && !EsRolAdmin && seccion[0] != "Privacidad") continue;
                            string urlDestino = seccion.Length > 3 ? seccion[3] : (seccion[0] + ".aspx");
                    %>
                    <a class="menu-item" aria-current="<%: ClaveSeccionActual == seccion[0] ? "page" : "false" %>"
                        href="<%: ResolveUrl("~/" + urlDestino) %>">
                        <span class="menu-icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="<%: seccion[2] %>" /></svg></span>
                        <%: seccion[1] %>
                    </a>
                    <% } } else if (!EsInicio) {
                        var secciones = new[] {
                            new[] { "diario", "Asientos contables / Libro diario", "Contabilidad.aspx?vista=diario", "M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" },
                            new[] { "CuentasPagar", "Cuentas por pagar", "CuentasPagar.aspx", "M1 4h22v16H1z M1 10h22" },
                            new[] { "tesoreria", "Cuentas por cobrar y cobros", "Contabilidad.aspx?vista=tesoreria", "M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3" },
                            new[] { "perdidas", "Pérdidas financieras por productos vencidos o dañados", "Contabilidad.aspx?vista=perdidas", "M10.29 3.86L1.82 18a2 2 0 0 1 1.71 3h16.94a2 2 0 0 1-1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01" }
                        };
                        string actual = PaginaActual == "Contabilidad"
                            ? (Request.QueryString["vista"] ?? "diario")
                            : (PaginaActual == "ReporteFlujoCaja" ? "CuentasPagar" : PaginaActual);
                        if (!Array.Exists(secciones, s => string.Equals(s[0], actual, StringComparison.OrdinalIgnoreCase)))
                            actual = "diario";
                        foreach (var seccion in secciones)
                        {
                    %>
                    <a class="menu-item" aria-current="<%: actual == seccion[0] ? "page" : "false" %>"
                        href="<%: ResolveUrl("~/" + seccion[2]) %>">
                        <span class="menu-icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="<%: seccion[3] %>" /></svg></span>
                        <%: seccion[1] %>
                    </a>
                    <% } } %>
                </nav>
                <div class="sidebar-footer">
                    <span>Dermo ERP</span>
                    <small><a href="<%: ResolveUrl("~/Privacidad.aspx") %>" style="color: inherit; text-decoration: none;">Privacidad y datos</a></small>
                </div>
            </aside>
            <main class="erp-contenido">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </form>
    <script>
        window.dermoDescargarPDF = function (elementId, filename) {
            if (typeof html2pdf === 'undefined') {
                window.print();
                return;
            }
            var el = document.getElementById(elementId);
            if (!el) return;

            var nombreArchivo = filename || 'Reporte_DermoERP.pdf';
            el.classList.add('pdf-modo-una-hoja');

            var opt = {
                margin: 0,
                filename: nombreArchivo,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, scrollY: 0, scrollX: 0, backgroundColor: '#ffffff' },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };

            var worker = html2pdf().set(opt).from(el);
            worker.toCanvas().toPdf().then(function () {
                el.classList.remove('pdf-modo-una-hoja');
                var canvas = worker.prop && worker.prop.canvas;
                var pdf = worker.prop && worker.prop.pdf;
                if (canvas && pdf && pdf.internal && pdf.internal.pageSize) {
                    var paginasPrevias = pdf.internal.getNumberOfPages();
                    pdf.addPage('a4', 'landscape');
                    for (var p = paginasPrevias; p >= 1; p--) {
                        pdf.deletePage(p);
                    }
                    pdf.setPage(1);
                    var pageW = pdf.internal.pageSize.getWidth();
                    var pageH = pdf.internal.pageSize.getHeight();
                    var margin = 8;
                    var maxW = pageW - margin * 2;
                    var maxH = pageH - margin * 2;
                    var ratio = Math.min(maxW / canvas.width, maxH / canvas.height);
                    var renderW = canvas.width * ratio;
                    var renderH = canvas.height * ratio;
                    var x = (pageW - renderW) / 2;
                    var y = margin;
                    pdf.addImage(canvas.toDataURL('image/jpeg', 0.98), 'JPEG', x, y, renderW, renderH);
                    pdf.save(nombreArchivo);
                } else {
                    worker.save();
                }
            }).catch(function (err) {
                el.classList.remove('pdf-modo-una-hoja');
                console.error('Error generando PDF:', err);
                html2pdf().set({
                    margin: [8, 8, 8, 8],
                    filename: nombreArchivo,
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true, scrollY: 0, scrollX: 0 },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
                }).from(el).save();
            });
        };
    </script>
</body>
</html>
